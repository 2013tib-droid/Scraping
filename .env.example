# Salin jadi .env dan isi. Berkas .env tidak pernah ikut ter-commit (.gitignore).
# Kalau dua variabel ini kosong, notifikasi turun ke terminal — bukan error.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Penilai dampak (inti/dampak.py). Kosong = halaman diurutkan jumlah media saja,
# tanpa blok "Penting Pagi Ini". Di GitHub Actions: gh secret set ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=

# Hanya perlu di balik proxy TLS-inspection kantor (Zscaler dan sejenisnya):
# arahkan ke bundel CA yang memuat sertifikat proxy.
# SSL_CERT_FILE=C:\path\ke\ca-bundle.pem

# Jalan terakhir kalau bundel CA tidak bisa didapat. Mematikan verifikasi TLS,
# jadi harus dinyalakan sadar — bukan fallback diam-diam.
# NOTIFIKASI_TANPA_VERIFIKASI=1
